---
/**
 * Button — editorial. Solid (ink fill), accent (ember), ghost (hairline),
 * link (underline-on-hover with arrow). Renders <a> or <button>.
 */
export interface Props {
  href?: string;
  variant?: "solid" | "accent" | "ghost" | "link";
  appearance?: string;
  size?: "md" | "sm";
  type?: "button" | "submit" | "reset";
  external?: boolean;
  arrow?: boolean;
  class?: string;
  "aria-label"?: string;
}
const {
  href,
  variant = "solid",
  size = "md",
  type = "button",
  external = false,
  arrow = false,
  class: className,
  "aria-label": ariaLabel,
} = Astro.props;
const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, `btn--${size}`, className]
  .filter(Boolean)
  .join(" ");
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  rel={rel}
  target={target}
  aria-label={ariaLabel}
>
  <span>
    <slot />
  </span>
  {arrow && (
    <span class="btn-arrow" aria-hidden="true">
      →
    </span>
  )}
</Tag>
