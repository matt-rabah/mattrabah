---
/**
 * Lozenge — quiet editorial status marker. Not a loud pill: small mono caps,
 * tinted background, a leading dot. status: live | progress | planned | draft
 */
export interface Props {
  label: string;
  status?: "live" | "progress" | "planned" | "draft";
  appearance?: string;
  isBold?: boolean;
  class?: string;
}
const {
  label,
  status = "draft",
  appearance,
  isBold = false,
  class: className,
} = Astro.props;
const statusVal = appearance ?? status;
const classes = [
  "loz",
  `loz--${statusVal}`,
  isBold ? "loz--bold" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<span class={classes}>
  <span class="loz-dot" aria-hidden="true"></span>
  {label}
</span>
