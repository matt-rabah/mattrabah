---
import "../styles/base.css";
import SeoHead from "../components/SeoHead.astro";

export interface Props {
  title: string;
  description?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    category?: string;
    tags?: string[];
  };
}

const SITE = "Matt Rabah";

const {
  title,
  description = "Selected work, tools, and writing by Matt Rabah, a Detroit-based customer experience, customer success, and implementation systems professional.",
  article,
} = Astro.props;

const year = new Date().getFullYear();
const home = Astro.url.pathname === "/";

const nav = [
  { href: "/work", label: "Work" },
  { href: "/tools", label: "Tools" },
  { href: "/blog", label: "Writing" },
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE ? `${SITE} — Selected Work` : `${title} — ${SITE}`}</title>
    <meta name="theme-color" content="#090909" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead title={title} description={description} article={article} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="portfolio-shell">
      <aside class="profile-panel" aria-label="Matt Rabah profile">
        <a class="profile-name" href="/" aria-label={`${SITE}, home`}>
          matt rabah<span aria-hidden="true">•</span>
        </a>
        {home ? (
          <h1 class="profile-title">Customer experience, in practice.</h1>
        ) : (
          <p class="profile-title">Customer experience, in practice.</p>
        )}
        <p class="profile-copy">
          I’m Matt, a customer experience and implementation professional based
          in Detroit. This is my work across customer success, CRM, and
          practical AI.
        </p>
        <div class="profile-actions">
          <a class="pill-button" href="/contact">
            Get in touch <span aria-hidden="true">↗</span>
          </a>
          <a class="profile-resume" href="/resume">
            Resume <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="profile-companies">
          <p>Selected experience</p>
          <div>
            <a href="/work#cadence-lab">Cadence Lab</a>
            <a href="/work#shinola">Shinola</a>
            <a href="/work#neurosync">NeuroSync</a>
          </div>
        </div>
        <nav class="profile-nav" aria-label="Primary">
          <a href="/" aria-current={home ? "page" : undefined}>
            Overview
          </a>
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                Astro.url.pathname.startsWith(item.href) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
        <p class="profile-location">
          Detroit, Michigan <span>© {year}</span>
        </p>
      </aside>
      <main
        id="main"
        class:list={["portfolio-content", { "portfolio-content--home": home }]}
        tabindex="-1"
      >
        <slot />
      </main>
    </div>
  </body>
</html>
