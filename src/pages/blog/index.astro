---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(({ id, data }) => ({
    title: data.title,
    dek: data.description,
    href: `/blog/${id}/`,
    date: data.date.toLocaleDateString("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }),
    type: data.category,
  }));
---

<BaseLayout
  title="Writing"
  description="Writing on customer experience, implementation, account health, lifecycle systems, and practical AI workflows."
>
  <div class="blog-index">
    <section class="container">
      <header class="blog-index-hero">
        <p class="eyebrow">Writing</p>
        <h1 class="h1">
          Notes on customer systems, implementation, and practical AI work.
        </h1>
        <p class="lead">
          Short pieces on the operating details behind better customer outcomes:
          onboarding, adoption, account health, retention, and the systems that
          make ownership visible.
        </p>
      </header>

      <div class="blog-list" aria-label="Published writing">
        {posts.map((post) => (
          <article class="blog-list-item">
            <a class="blog-list-link" href={post.href}>
              <p class="blog-list-date">{post.date}</p>

              <div>
                <p class="meta">{post.type}</p>
                <h2 class="blog-list-title">{post.title}</h2>
              </div>

              <p class="blog-list-dek">{post.dek}</p>

              <span class="blog-list-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
