---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Lozenge from "../components/lozenge.astro";
import Tag from "../components/ui/Tag.astro";
import { getCollection } from "astro:content";

const work = [
  {
    index: "01",
    href: "/work#cadence-lab",
    kicker: "Independent practice",
    title: "Cadence Lab",
    line: "Developed customer journey diagnostics, onboarding frameworks, and retention processes for service businesses.",
    tags: ["Lifecycle design", "Retention"],
  },
  {
    index: "02",
    href: "/work#shinola",
    kicker: "Brand-side retail",
    title: "Shinola",
    line: "Managed corporate accounts at the Detroit flagship, connecting personal client service with Salesforce segmentation and account process.",
    tags: ["Portfolio growth", "Salesforce"],
  },
  {
    index: "03",
    href: "/work#neurosync",
    kicker: "Healthtech",
    title: "NeuroSync",
    line: "Built a customer success function for a clinical platform, from onboarding and adoption tracking to renewal readiness.",
    tags: ["Customer success", "Implementation"],
  },
];

const tools = [
  { title: "Handoff Risk Checker", status: "progress", label: "Prototype" },
  {
    title: "Customer Health Signal Mapper",
    status: "progress",
    label: "Prototype",
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
  },
];

const writing = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map(({ id, data }) => ({
    title: data.title,
    meta: data.category,
    href: `/blog/${id}/`,
  }));
---

<BaseLayout title="Matt Rabah">
  <section class="portfolio-intro container">
    <p class="meta">Matt Rabah · Detroit, Michigan</p>
    <h1>
      Customer experience,
      <br />
      in practice.
    </h1>
    <p class="lead">
      Selected work in customer success, implementation, and CRM — across
      healthtech, retail, and my independent practice at Cadence Lab.
    </p>
    <a class="intro-link" href="/about">
      About me <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Selected work</h2>
        </div>
        <Button href="/work" variant="link" arrow>
          All work
        </Button>
      </div>
      <div class="work-list">
        {work.map((w) => (
          <Card href={w.href} index={w.index}>
            <p class="meta" style="color:var(--color-text-accent)">
              {w.kicker}
            </p>
            <h3 class="h3" style="margin-top:var(--space-2)">
              {w.title}
            </h3>
            <p class="body" style="margin-top:var(--space-3); max-width:46ch">
              {w.line}
            </p>
            <div class="chip-row">
              {w.tags.map((t) => (
                <Tag text={t} />
              ))}
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Tools & experiments</h2>
        </div>
        <Button href="/tools" variant="link" arrow>
          Explore prototypes
        </Button>
      </div>
      <div class="tool-row">
        {tools.map((t) => (
          <Card href="/tools" flat>
            <Lozenge label={t.label} status={t.status as any} />
            <h3 class="h4" style="margin-top:var(--space-3)">
              {t.title}
            </h3>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Writing</h2>
        </div>
        <Button href="/blog" variant="link" arrow>
          All writing
        </Button>
      </div>
      <div class="writing-list">
        {writing.map((w, idx) => (
          <a href={w.href} class="writing-row">
            <span class="meta writing-idx">
              {String(idx + 1).padStart(2, "0")}
            </span>
            <span class="writing-text">
              <span class="meta" style="color:var(--color-text-accent)">
                {w.meta}
              </span>
              <span class="h3 writing-title">{w.title}</span>
            </span>
            <span class="writing-arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .portfolio-intro {
      padding-block: clamp(3rem, 7vw, 5.5rem) 3rem;
    }
    .portfolio-intro h1 {
      font-size: clamp(2.4rem, 5vw, 4rem);
      font-weight: 600;
      line-height: 1.12;
      letter-spacing: -0.045em;
      margin-block: 1.25rem;
    }
    .portfolio-intro .lead {
      max-width: 58ch;
    }
    .intro-link {
      display: inline-flex;
      gap: 0.75rem;
      margin-top: 1.5rem;
      font-size: 0.9375rem;
      text-underline-offset: 0.3em;
    }
    .section {
      padding-block: 2.5rem;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      max-width: none;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .section-head > div {
      gap: 0;
    }
    .section-head .h2 {
      font-size: 1.35rem;
      letter-spacing: -0.025em;
    }

    .work-list {
      display: grid;
      gap: var(--space-4);
    }
    @media (min-width: 52rem) {
      .work-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-5);
    }
    .tool-row {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }
    .writing-list {
      display: grid;
    }
    .writing-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) 0;
      border-top: 1px solid var(--color-border);
      color: inherit;
      text-decoration: none;
      transition: padding var(--dur-2) var(--ease);
    }
    .writing-row:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .writing-row:hover {
      padding-inline: var(--space-3);
    }
    .writing-idx {
      color: var(--color-text-faint);
    }
    .writing-text {
      display: grid;
      gap: var(--space-2);
    }
    .writing-title {
      color: var(--color-text);
      transition: color var(--dur-1) var(--ease);
      max-width: 40ch;
    }
    .writing-row:hover .writing-title {
      color: var(--color-text-accent);
    }
    .writing-arrow {
      color: var(--color-text-faint);
      transition:
        transform var(--dur-1) var(--ease),
        color var(--dur-1) var(--ease);
    }
    .writing-row:hover .writing-arrow {
      color: var(--color-text-accent);
      transform: translateX(4px);
    }
  </style>
</BaseLayout>
