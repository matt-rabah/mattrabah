---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Lozenge from "../components/lozenge.astro";
import Tag from "../components/ui/Tag.astro";
import TiltCard from "../components/TiltCard.svelte";
import { getCollection } from "astro:content";

const work = [
  {
    index: "01",
    href: "/work#cadence-lab",
    kicker: "Independent practice",
    title: "Cadence Lab",
    line: "Developed customer journey diagnostics, onboarding frameworks, and retention processes for service businesses.",
    tags: ["Lifecycle design", "Retention"],
  },
  {
    index: "02",
    href: "/work#shinola",
    kicker: "Brand-side retail",
    title: "Shinola",
    line: "Managed corporate accounts at the Detroit flagship, connecting personal client service with Salesforce segmentation and account process.",
    tags: ["Portfolio growth", "Salesforce"],
  },
  {
    index: "03",
    href: "/work#neurosync",
    kicker: "Healthtech",
    title: "NeuroSync",
    line: "Built a customer success function for a clinical platform, from onboarding and adoption tracking to renewal readiness.",
    tags: ["Customer success", "Implementation"],
  },
];

const tools = [
  { title: "Handoff Risk Checker", status: "live", label: "Interactive" },
  {
    title: "Customer Health Signal Mapper",
    status: "live",
    label: "Interactive",
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
  },
];

const writing = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map(({ id, data }) => ({
    title: data.title,
    meta: data.category,
    href: `/blog/${id}/`,
  }));
---

<BaseLayout title="Matt Rabah">
  <section class="portfolio-intro">
    <div class="container hero-content">
      <div class="cyber-badge reveal reveal-1">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>Matt Rabah · Detroit, MI · Open to Roles</span>
      </div>
      <h1 class="display hero-title reveal reveal-2">
        Customer experience,
        <br />
        <span class="gradient-text">in practice.</span>
      </h1>
      <p class="lead hero-lead reveal reveal-3">
        Selected work in customer success, implementation architecture, and CRM
        — across healthtech platforms, flagship retail, and independent advisory
        at Cadence Lab.
      </p>
      <div class="hero-actions reveal reveal-3">
        <Button href="/about" variant="accent" arrow>
          About my background
        </Button>
        <Button href="/work" variant="ghost" arrow>
          View case studies
        </Button>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Selected work</h2>
          <p
            class="meta"
            style="color:var(--color-text-subtlest); margin-top:0.25rem;"
          >
            Real-world systems, diagnostics, and outcomes
          </p>
        </div>
        <Button href="/work" variant="link" arrow>
          All work
        </Button>
      </div>
      <div class="work-list">
        {work.map((w) => (
          <TiltCard
            client:visible
            href={w.href}
            glowColor="cyan"
            class="work-card-wrapper"
          >
            <div class="card-inner">
              <span class="card-index meta" aria-hidden="true">
                {w.index}
              </span>
              <p class="meta" style="color:var(--color-text-accent)">
                {w.kicker}
              </p>
              <h3 class="h3" style="margin-top:var(--space-2)">
                {w.title}
              </h3>
              <p class="body" style="margin-top:var(--space-3); max-width:46ch">
                {w.line}
              </p>
              <div class="chip-row">
                {w.tags.map((t) => (
                  <Tag text={t} />
                ))}
              </div>
              <span class="card-arrow" aria-hidden="true">
                →
              </span>
            </div>
          </TiltCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Tools & experiments</h2>
          <p
            class="meta"
            style="color:var(--color-text-subtlest); margin-top:0.25rem;"
          >
            AI workflow prototypes built for customer operations
          </p>
        </div>
        <Button href="/tools" variant="link" arrow>
          Explore prototypes
        </Button>
      </div>
      <div class="tool-row">
        {tools.map((t) => (
          <TiltCard
            client:visible
            href="/tools"
            glowColor="crimson"
            flat
            class="tool-card-wrapper"
          >
            <div class="card-inner tool-card-inner">
              <Lozenge label={t.label} status={t.status as any} />
              <h3 class="h4" style="margin-top:var(--space-3)">
                {t.title}
              </h3>
              <span class="card-arrow" aria-hidden="true">
                →
              </span>
            </div>
          </TiltCard>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="h2">Writing</h2>
        </div>
        <Button href="/blog" variant="link" arrow>
          All writing
        </Button>
      </div>
      <div class="writing-list">
        {writing.map((w, idx) => (
          <a href={w.href} class="writing-row">
            <span class="meta writing-idx">
              {String(idx + 1).padStart(2, "0")}
            </span>
            <span class="writing-text">
              <span class="meta" style="color:var(--color-text-accent)">
                {w.meta}
              </span>
              <span class="h3 writing-title">{w.title}</span>
            </span>
            <span class="writing-arrow" aria-hidden="true">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .portfolio-intro {
      position: relative;
      padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 4.5rem);
      overflow: hidden;
      border-bottom: 1px solid var(--color-border);
    }
    .hero-content {
      position: relative;
      z-index: 2;
    }
    .cyber-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--color-border-strong);
      background: color-mix(
        in srgb,
        var(--color-surface-raised) 80%,
        transparent
      );
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--color-text-subtle);
      margin-bottom: 1.5rem;
    }
    .pulse-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--color-accent);
      box-shadow: 0 0 10px var(--color-accent);
      animation: pulse-glow 2.4s infinite ease-in-out;
    }
    @keyframes pulse-glow {
      0%,
      100% {
        opacity: 0.4;
        transform: scale(0.85);
      }
      50% {
        opacity: 1;
        transform: scale(1.2);
      }
    }
    .hero-title {
      font-size: clamp(2.6rem, 5.5vw, 4.2rem);
      font-weight: 600;
      line-height: 1.08;
      letter-spacing: -0.045em;
      margin-block: 0.5rem 1.25rem;
    }
    .gradient-text {
      background: linear-gradient(
        135deg,
        var(--color-text) 40%,
        var(--color-text-accent) 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-lead {
      max-width: 54ch;
      margin-bottom: 2rem;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
    }
    .section {
      padding-block: 3rem;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      max-width: none;
      margin-bottom: 1.75rem;
      flex-wrap: wrap;
    }
    .section-head .h2 {
      font-size: 1.45rem;
      letter-spacing: -0.025em;
    }

    .work-list {
      display: grid;
      gap: var(--space-5);
    }
    @media (min-width: 52rem) {
      .work-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    .card-inner {
      position: relative;
      padding: clamp(var(--space-5), 3vw, var(--space-6));
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    .tool-card-inner {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: color-mix(
        in srgb,
        var(--color-surface-raised) 50%,
        transparent
      );
      backdrop-filter: blur(8px);
      transition: border-color 200ms ease;
    }
    .tool-card-inner:hover {
      border-color: var(--color-border-accent);
    }
    .card-index {
      display: block;
      font-size: var(--fs-meta);
      color: var(--color-text-faint);
      margin-bottom: var(--space-3);
    }
    .card-arrow {
      position: absolute;
      top: clamp(var(--space-5), 3vw, var(--space-6));
      right: clamp(var(--space-5), 3vw, var(--space-6));
      color: var(--color-text-faint);
      transition:
        transform var(--dur-1) var(--ease),
        color var(--dur-1) var(--ease);
    }
    :global(.tilt-card:hover) .card-arrow {
      color: var(--color-text-accent);
      transform: translate(3px, -3px);
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: auto;
      padding-top: var(--space-5);
    }
    .tool-row {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }
    .writing-list {
      display: grid;
    }
    .writing-row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) 0;
      border-top: 1px solid var(--color-border);
      color: inherit;
      text-decoration: none;
      transition: padding var(--dur-2) var(--ease);
    }
    .writing-row:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .writing-row:hover {
      padding-inline: var(--space-3);
    }
    .writing-idx {
      color: var(--color-text-faint);
    }
    .writing-text {
      display: grid;
      gap: var(--space-2);
    }
    .writing-title {
      color: var(--color-text);
      transition: color var(--dur-1) var(--ease);
      max-width: 40ch;
    }
    .writing-row:hover .writing-title {
      color: var(--color-text-accent);
    }
    .writing-arrow {
      color: var(--color-text-faint);
      transition:
        transform var(--dur-1) var(--ease),
        color var(--dur-1) var(--ease);
    }
    .writing-row:hover .writing-arrow {
      color: var(--color-text-accent);
      transform: translateX(4px);
    }
  </style>
</BaseLayout>
