---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lozenge from "../components/lozenge.astro";
import { getCollection } from "astro:content";

const work = [
  {
    index: "01",
    href: "/work#cadence-lab",
    kicker: "Independent practice",
    title: "Cadence Lab",
    service: "Lifecycle Diagnostics & Retention",
    duration: "Ongoing Advisory",
    year: "2024 — 2026",
    line: "Customer journey diagnostics, onboarding frameworks, and retention processes for high-touch service businesses.",
    tags: ["Lifecycle design", "Retention", "CRM Ops"],
  },
  {
    index: "02",
    href: "/work#shinola",
    kicker: "Brand-side retail",
    title: "Shinola",
    service: "Enterprise Portfolio CX",
    duration: "Detroit Flagship",
    year: "2021 — 2024",
    line: "Managed corporate accounts at the Detroit flagship, connecting personal client service with Salesforce segmentation and account process.",
    tags: ["Portfolio growth", "Salesforce", "Executive CX"],
  },
  {
    index: "03",
    href: "/work#neurosync",
    kicker: "Healthtech",
    title: "NeuroSync",
    service: "Customer Success 0-to-1",
    duration: "Clinical Platform",
    year: "2020 — 2021",
    line: "Built a customer success function for a clinical platform, from onboarding and adoption tracking to renewal readiness.",
    tags: ["Customer success", "Implementation", "Healthtech"],
  },
];

const tools = [
  { title: "Handoff Risk Checker", status: "live", label: "Interactive" },
  {
    title: "Customer Health Signal Mapper",
    status: "live",
    label: "Interactive",
  },
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
  },
];

const writing = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map(({ id, data }) => ({
    title: data.title,
    meta: data.category,
    href: `/blog/${id}/`,
  }));

// Decorative cover artwork from the user-selected v0 portfolio template.
const covers = [
  "/images/portfolio/cadence-cover.webp",
  "/images/portfolio/shinola-cover.webp",
  "/images/portfolio/neurosync-cover.webp",
];
---

<BaseLayout title="Matt Rabah">
  <section class="project-gallery" aria-label="Selected work">
    {work.map((w, i) => (
      <article class="project-cover">
        <img
          src={covers[i]}
          alt=""
          width="1200"
          height="1000"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
        <div class="cover-tags">
          {w.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
        <div class="cover-caption">
          <div>
            <p>{w.kicker}</p>
            <h2>{w.title}</h2>
            <p>{w.service}</p>
          </div>
          <a
            class="pill-button"
            href={w.href}
            aria-label={`View ${w.title} case study`}
          >
            Case study <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </section>
  <section class="content-panel">
    <div class="section-heading">
      <h2>Tools & experiments</h2>
      <a href="/tools">Explore tools ↗</a>
    </div>
    <div class="tool-row">
      {tools.map((t) => (
        <a class="tool-card" href="/tools">
          <Lozenge label={t.label} status={t.status as "live" | "planned"} />
          <h3>{t.title}</h3>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="content-panel">
    <div class="section-heading">
      <h2>Writing</h2>
      <a href="/blog">All writing ↗</a>
    </div>
    <div class="writing-list">
      {writing.map((w) => (
        <a class="writing-row" href={w.href}>
          <div>
            <p class="meta">{w.meta}</p>
            <h3>{w.title}</h3>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
