---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";
import Lozenge from "../../components/lozenge.astro";
import InteractiveToolsSuite from "../../components/tools/InteractiveToolsSuite.svelte";

const tools = [
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
    body: "Tests whether an account is operationally, commercially, and relationship-ready for renewal — before the date forces the conversation.",
    inputs: ["Adoption", "Sponsor", "Business value", "Open risks"],
  },
  {
    title: "QBR Question Builder",
    status: "planned",
    label: "Planned",
    body: "Builds executive review questions around decisions, value, and unresolved risk instead of letting the QBR collapse into a recap deck.",
    inputs: ["Account stage", "Outcomes", "Open risks", "Expansion"],
  },
  {
    title: "CRM Field Quality Checker",
    status: "planned",
    label: "Planned",
    body: "Checks whether a CRM field has a real owner, a useful cadence, and a customer-facing decision it actually supports — or whether it's just noise.",
    inputs: ["Field", "Owner", "Cadence", "Decision"],
  },
];
---

<BaseLayout
  title="Tools"
  description="Interactive practical AI diagnostics and tools from Matt Rabah for CX, customer success, and implementation teams — handoff risk, account health, renewal readiness."
>
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>Interactive Diagnostics Suite</span>
      </div>
      <h1 class="display reveal reveal-1">Small tools for real problems.</h1>
      <p
        class="lead reveal reveal-2"
        style="max-width:54ch; margin-top:var(--space-4)"
      >
        Live, interactive prototypes designed to eliminate customer blindspots:
        unvalidated handoff promises, silent health decay, and renewal cliff
        risks.
      </p>

      <div class="suite-wrapper">
        <InteractiveToolsSuite client:load />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h3">Upcoming Roadmap & Diagnostics</h2>
        <p class="body-sm text-subtle">
          Additional operational frameworks currently in design.
        </p>
      </div>

      <div class="tool-grid">
        {tools.map((t) => (
          <article class="tool">
            <div class="tool-head">
              <h3 class="h4">{t.title}</h3>
              <Lozenge label={t.label} status={t.status as any} />
            </div>
            <p
              class="body-sm"
              style="max-width:50ch; color:var(--color-text-subtle)"
            >
              {t.body}
            </p>
            <div class="chip-row">
              {t.inputs.map((i) => (
                <Tag text={i} />
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(var(--space-9), 12vw, 8rem) var(--space-6);
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.35rem 0.95rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--color-border-strong);
      background: color-mix(
        in srgb,
        var(--color-surface-raised) 80%,
        transparent
      );
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      color: var(--color-text-subtle);
      margin-bottom: 1.5rem;
    }
    .pulse-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--neon-cyan);
      box-shadow: 0 0 10px var(--neon-cyan);
      animation: pulse-glow 2.4s infinite ease-in-out;
    }
    @keyframes pulse-glow {
      0%,
      100% {
        opacity: 0.4;
        transform: scale(0.85);
      }
      50% {
        opacity: 1;
        transform: scale(1.2);
      }
    }
    .suite-wrapper {
      margin-top: var(--space-6);
    }
    .section-head {
      margin-bottom: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .tool-grid {
      display: grid;
      gap: 0;
    }
    .tool {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-7) 0;
      border-top: 1px solid var(--color-border);
    }
    .tool:last-child {
      border-bottom: 1px solid var(--color-border);
    }
    .tool-head {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  </style>
</BaseLayout>
