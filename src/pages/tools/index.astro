---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";
import Lozenge from "../../components/lozenge.astro";
import InteractiveToolsSuite from "../../components/tools/InteractiveToolsSuite.svelte";

const tools = [
  {
    title: "Renewal Readiness Diagnostic",
    status: "planned",
    label: "Planned",
    body: "Tests whether an account is operationally, commercially, and relationship-ready for renewal — before the date forces the conversation.",
    inputs: ["Adoption", "Sponsor", "Business value", "Open risks"],
  },
  {
    title: "QBR Question Builder",
    status: "planned",
    label: "Planned",
    body: "Builds executive review questions around decisions, value, and unresolved risk instead of letting the QBR collapse into a recap deck.",
    inputs: ["Account stage", "Outcomes", "Open risks", "Expansion"],
  },
  {
    title: "CRM Field Quality Checker",
    status: "planned",
    label: "Planned",
    body: "Checks whether a CRM field has a real owner, a useful cadence, and a customer-facing decision it actually supports — or whether it's just noise.",
    inputs: ["Field", "Owner", "Cadence", "Decision"],
  },
];
---

<BaseLayout
  title="Tools"
  description="Interactive practical AI diagnostics and tools from Matt Rabah for CX, customer success, and implementation teams — handoff risk, account health, renewal readiness."
>
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>Interactive Diagnostics Suite</span>
      </div>
      <h1 class="display reveal reveal-1">Small tools for real problems.</h1>
      <p
        class="lead reveal reveal-2"
        style="max-width:54ch; margin-top:var(--space-4)"
      >
        Live, interactive prototypes designed to eliminate customer blindspots:
        unvalidated handoff promises, silent health decay, and renewal cliff
        risks.
      </p>

      <div class="suite-wrapper">
        <InteractiveToolsSuite client:load />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h3">Upcoming Roadmap & Diagnostics</h2>
        <p class="body-sm text-subtle">
          Additional operational frameworks currently in design.
        </p>
      </div>

      <div class="tool-grid">
        {tools.map((t) => (
          <article class="tool">
            <div class="tool-head">
              <h3 class="h4">{t.title}</h3>
              <Lozenge label={t.label} status={t.status as any} />
            </div>
            <p
              class="body-sm"
              style="max-width:50ch; color:var(--color-text-subtle)"
            >
              {t.body}
            </p>
            <div class="chip-row">
              {t.inputs.map((i) => (
                <Tag text={i} />
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
