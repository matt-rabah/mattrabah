---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/ui/Tag.astro";

/* NOTE: result lines are written as defensible qualitative outcomes. Where you
   have real numbers (onboarding time cut, NRR, response time, portfolio size),
   drop them into `result` — concrete figures are the single biggest credibility
   lever on this page. Don't invent them; a vague number is worse than none. */
const work = [
  {
    id: "cadence-lab",
    kicker: "Cadence Lab · Service businesses",
    title: "Cadence Lab",
    role: "Lifecycle diagnostics & retention",
    challenge:
      "Service businesses with loyal customers but no lifecycle visibility — they couldn't tell you where customers stalled, why they churned, or which moments actually built loyalty.",
    approach:
      "I built customer journey diagnostics, onboarding and retention frameworks, and lifecycle maturity models, then translated all of it into a CRM and operating rhythm the team could run without me.",
    result:
      "Clients went from intuition to a map: a clear view of the journey, the stall points, and the handful of moments worth investing in. CX language became decisions a team could act on.",
    tags: [
      "Journey diagnostics",
      "Retention frameworks",
      "Lifecycle maturity",
      "Operating rhythm",
    ],
  },
  {
    id: "shinola",
    kicker: "Brand-side retail · Detroit flagship",
    title: "Shinola",
    role: "Portfolio growth & high-touch CX",
    challenge:
      "A corporate account portfolio inside a premium brand had to feel personal to every client while still operating at scale. Relationships were strong but unevenly tracked, and growth depended on memory.",
    approach:
      "I connected the high-touch client experience to a real operating model — Salesforce segmentation and process, clear account ownership, executive-facing communication, and a cadence that kept the personal touch from breaking as the book grew.",
    result:
      "Account work became visible and repeatable without losing what made it feel bespoke. The portfolio had a system behind the relationships, not just goodwill.",
    tags: [
      "Portfolio management",
      "Salesforce process",
      "Executive accounts",
      "Client experience",
    ],
  },
  {
    id: "neurosync",
    kicker: "Healthtech · Clinical platform",
    title: "NeuroSync",
    role: "Built the customer success function",
    challenge:
      "A clinical platform was closing deals faster than it could onboard them. Customers signed, then stalled — implementation lived in people's heads, adoption wasn't tracked, and renewals arrived as surprises.",
    approach:
      "I stood up the customer success motion end to end: a repeatable onboarding path, adoption checkpoints tied to clinical and operational use, account health signals the team could actually act on, and a renewal readiness review that started months before the date.",
    result:
      "Onboarding stopped depending on individual heroics. The team could see which accounts were healthy, which were drifting, and what to do next — before a renewal conversation forced the issue.",
    tags: [
      "Onboarding & implementation",
      "Adoption tracking",
      "Account health",
      "Renewal readiness",
    ],
  },
];
---

<BaseLayout
  title="Work"
  description="Selected work from Matt Rabah across customer success, implementation, lifecycle design, and CRM discipline — in healthtech, retail, and consulting."
>
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>Proven Case Studies</span>
      </div>
      <h1 class="display reveal reveal-1">Selected work.</h1>
      <p
        class="lead reveal reveal-2"
        style="max-width:54ch; margin-top:var(--space-4)"
      >
        A closer look at my role, operational frameworks, and tangible business
        outcomes across Cadence Lab, Shinola, and NeuroSync.
      </p>
    </div>
  </section>

  <!-- Sticky Project Navigator -->
  <nav class="case-nav" aria-label="Portfolio Projects">
    <div class="container case-nav-inner">
      {work.map((w, idx) => (
        <a href={`#${w.id}`} class="case-nav-link">
          <span class="nav-idx">0{idx + 1}</span>
          <span class="nav-name">{w.title}</span>
          <span class="nav-arrow" aria-hidden="true">
            ↓
          </span>
        </a>
      ))}
    </div>
  </nav>

  {work.map((w, i) => (
    <section id={w.id} class={`section case ${i % 2 ? "section--alt" : ""}`}>
      <div class="container case-grid">
        <aside class="case-aside">
          <span class="case-number meta" aria-hidden="true">
            PROJECT 0{i + 1}
          </span>
          <p class="meta" style="color:var(--color-text-accent)">
            {w.kicker}
          </p>
          <h2 class="h1 case-title">{w.title}</h2>
          <p class="meta case-role">{w.role}</p>
          <div class="chip-col">
            {w.tags.map((t) => (
              <Tag text={t} />
            ))}
          </div>
        </aside>
        <div class="case-body">
          <div class="case-block">
            <p class="case-label">The challenge</p>
            <p class="body">{w.challenge}</p>
          </div>
          <div class="case-block">
            <p class="case-label">What I did</p>
            <p class="body">{w.approach}</p>
          </div>
          <div class="case-block case-block--result">
            <div class="result-badge">
              <span class="result-dot" aria-hidden="true"></span>
              <span>Validated Outcome</span>
            </div>
            <p class="body result-body">{w.result}</p>
          </div>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
